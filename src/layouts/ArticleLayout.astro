---
/**
 * ArticleLayout — the wrapper for every content-collection page. Renders the
 * H1 + last-reviewed date, breadcrumbs, the MDX body (default slot), an optional
 * FAQ block, the AuthorBox, a related-links block, and a contextual CTA chosen
 * by the `cta` frontmatter field. Emits the full schema graph (Article, Person,
 * Organization, Breadcrumb, + optional Course / FAQPage / HowTo).
 */
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AuthorBox from "../components/AuthorBox.astro";
import FAQ from "../components/FAQ.astro";
import SignupForm from "../components/SignupForm.astro";
import type { Crumb, FaqItem, HowToStep } from "../lib/schema";
import {
  graph,
  articleSchema,
  courseSchema,
  personSchema,
  organizationSchema,
  breadcrumbSchema,
  faqSchema,
  howToSchema,
} from "../lib/schema";

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lastReviewed: Date;
  datePublished?: Date;
  cta?: "signup" | "course" | "directory";
  course?: boolean;
  faqs?: FaqItem[];
  howToSteps?: HowToStep[];
  ogImage?: string;
  /** Breadcrumb trail (caller supplies; always starts at Home). */
  crumbs: Crumb[];
  /** Internal related links (sibling/section pages). */
  relatedLinks?: RelatedLink[];
}

const {
  title,
  description,
  lastReviewed,
  datePublished,
  cta = "signup",
  course = false,
  faqs = [],
  howToSteps = [],
  ogImage,
  crumbs,
  relatedLinks = [],
} = Astro.props;

// Strip the ".html" that build.format: "file" puts on Astro.url.pathname, so the
// schema URL matches the clean canonical/sitemap URL (e.g. "/cpd/free-resources").
const path = Astro.url.pathname.replace(/\.html$/, "");

// Human-readable, machine-readable dates.
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const reviewedISO = lastReviewed.toISOString();
const publishedISO = (datePublished ?? lastReviewed).toISOString();

// Build the structured-data graph for this article.
const schemaGraph = graph(
  organizationSchema(),
  personSchema(),
  articleSchema({
    title,
    description,
    url: path,
    datePublished: publishedISO,
    dateModified: reviewedISO,
    image: ogImage,
  }),
  course ? courseSchema({ name: title, description, url: path }) : null,
  breadcrumbSchema(crumbs),
  faqs.length ? faqSchema(faqs) : null,
  howToSteps.length ? howToSchema(title, howToSteps) : null,
);

// Contextual CTA config — keyed off the `cta` frontmatter field.
// "signup" renders the SignupForm; the others are simple link blocks.
const CTAS = {
  course: {
    heading: "Train with a practitioner",
    body: "CPD authored by a working surveyor who also trains new students. Courses are added as they're ready — join the list for early access and a launch discount.",
    label: "See Dom's CPD courses",
    href: "/courses",
  },
  directory: {
    heading: "Free CPD to get you started",
    body: "A curated, practitioner-annotated directory of (mostly free) CPD across the property professions — updated as Dom finds the good stuff.",
    label: "Browse the free CPD directory",
    href: "/cpd/free-resources",
  },
} as const;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  schema={[schemaGraph]}
>
  <div class="container">
    <article class="article measure">
      <Breadcrumbs crumbs={crumbs} />

      <header class="article-head">
        <h1>{title}</h1>
        <p class="reviewed">
          Last reviewed
          <time datetime={reviewedISO}>{fmt(lastReviewed)}</time>
        </p>
      </header>

      <div class="prose">
        <slot />
      </div>

      {faqs.length > 0 && <FAQ items={faqs} />}

      <AuthorBox />

      {
        relatedLinks.length > 0 && (
          <nav class="related" aria-label="Related guides">
            <h2>Related guides</h2>
            <ul>
              {relatedLinks.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        cta === "signup" ? (
          <SignupForm source={path} />
        ) : (
          <section class="cta-block card">
            <h2>{CTAS[cta].heading}</h2>
            <p>{CTAS[cta].body}</p>
            <a class="btn btn-primary" href={CTAS[cta].href}>
              {CTAS[cta].label}
            </a>
          </section>
        )
      }
    </article>
  </div>
</BaseLayout>

<style>
  .article { padding-block: var(--space-8) var(--space-12); }
  .article-head .reviewed {
    color: var(--color-muted);
    font-size: 0.875rem;
    margin-top: calc(-1 * var(--space-2));
  }

  /* Article body typography — comfortable reading measure. */
  .prose :global(h2) { margin-top: var(--space-12); }
  .prose :global(h3) { margin-top: var(--space-8); }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.25rem; }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(a) { text-decoration: underline; }
  .prose :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    border-left: 4px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--color-ink);
  }
  /* Note/caution callout — use a blockquote with class="warn" in MDX. */
  .prose :global(.warn) {
    border-left-color: var(--color-warn);
    background: var(--color-warn-bg);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: 0.9375rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--color-border);
    padding: var(--space-3);
    text-align: left;
  }
  .prose :global(th) { background: var(--color-surface); }

  .related { margin-block: var(--space-12); }
  .related ul { padding-left: 1.25rem; }
  .related li { margin-bottom: var(--space-2); }

  .cta-block { margin-block: var(--space-12); }
  .cta-block h2 { margin-top: 0; }
</style>
